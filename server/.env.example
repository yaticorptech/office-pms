# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8090

# Comma-separated list of origins allowed to call the API from a browser.
# Not needed when SERVE_CLIENT=true, because the app is then same-origin.
CLIENT_ORIGIN=http://localhost:5173

# Number of proxies in front of the app, so the real client IP is used for rate
# limiting. 1 suits Render/Railway/Fly/Heroku or a single nginx. Defaults to 1 in
# production and off elsewhere. Setting this too high lets clients spoof their IP.
# TRUST_PROXY=1

# ── Database ──────────────────────────────────────────────────────────────────
# Point this at a local MongoDB or an Atlas cluster, e.g.
#   mongodb://127.0.0.1:27017
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net
# Leave it empty to use the bundled embedded MongoDB (data persists in server/.data/mongo).
# Required in production — the embedded database is for development only.
MONGODB_URI=
DB_NAME=office_pms
USE_EMBEDDED_MONGO=true
# EMBEDDED_MONGO_PATH=./.data/mongo

# ── Auth ──────────────────────────────────────────────────────────────────────
# Required in production, minimum 32 characters. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=office-pms-dev-secret-change-me
JWT_EXPIRES_IN=7d
# Cost factor for password hashing. 12 is a good production value; 10 is the floor.
BCRYPT_ROUNDS=10

# ── Serving the built client ──────────────────────────────────────────────────
# On: this process serves client/dist as well as the API, giving a single-origin
# deployment with working deep links and no CORS. Defaults to on in production.
# Turn it off when the frontend is hosted separately (Netlify, Vercel, a CDN).
# SERVE_CLIENT=true
# CLIENT_DIST_PATH=../client/dist
# Extra origins the served page may call, if the API lives on another host.
# CSP_CONNECT_SRC=https://api.your-company.com

# ── Rate limiting ─────────────────────────────────────────────────────────────
# On everywhere except the test suite.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=600
# Sign-in and password-change endpoints. Successful sign-ins are not counted, so
# only repeated failures from one address trip this.
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=10

# ── Seed accounts (npm run seed) ──────────────────────────────────────────────
# Development only. The seed refuses to run with NODE_ENV=production, because it
# writes these well-known passwords and `--fresh` deletes all existing data.
# In production, bootstrap the first admin through POST /api/auth/register.
SEED_ADMIN_NAME=Admin User
SEED_ADMIN_EMAIL=admin@office.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_EMPLOYEE_PASSWORD=Employee@123
